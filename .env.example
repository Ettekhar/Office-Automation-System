# ==========================================
# 3. Dev Assistant — multi-provider LLM chain (all optional, free tiers)
# ==========================================
# Only the keys you set are used, tried in this priority order with automatic
# fallback on any failure (invalid key, retired model 404, 429/quota, timeout,
# network error, empty answer, HTTP-200-with-error-body):
#   1. Google Gemini (AI Studio)  2. Groq  3. OpenRouter  4. Mistral
#   5. Cloudflare Worker (optional RAG gateway, see section 4)
#   6. Builtin deterministic engine (always the final fallback, needs no key)
# With no keys at all, the builtin engine answers everything.
# Diagnose the live chain any time with: node scripts/diagnose-providers.mjs
#GEMINI_API_KEY=
#GROQ_API_KEY=
#OPENROUTER_API_KEY=
#MISTRAL_API_KEY=
# Optional per-provider model overrides. COMMA-SEPARATED LISTS ARE ALLOWED and
# are tried in order, so a retired/rate-limited model falls through to the next
# model of the SAME provider before the next provider is tried.
# Defaults (all verified live — see the scripts/ probes):
#GEMINI_MODEL=gemini-3.6-flash,gemini-3-flash-preview,gemini-flash-latest
#GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
#OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free,cohere/north-mini-code:free
#MISTRAL_MODEL=mistral-small-latest
# Global override for every provider (single value):
#LLM_MODEL=
# Optional base-URL overrides (proxies / self-hosted gateways):
#GEMINI_BASE_URL=
#GROQ_BASE_URL=
#OPENROUTER_BASE_URL=
#MISTRAL_BASE_URL=
# Set to 1 to force the builtin engine and never call any LLM:
#LLM_DISABLE=1
# Cloudflare Worker RAG gateway (your deployed dev-assistant worker). When the
# URL is set it joins the chain as provider #5 — the dashboard FEEDS the tracker
# data to it (question + projects inline), and the worker answers using its own
# AI chain (or its builtin fallback). Token is optional; only sent if set.
# MUST be a full https URL: a token pasted here is skipped with a warning.
#CLOUDFLARE_WORKER_URL=
#CLOUDFLARE_WORKER_TOKEN=
# On the worker side, set API_TOKEN (wrangler secret) to the same token value
# to require auth; leave it unset for an open endpoint.

# ==========================================
# 4. Google Docs / SOP RAG (optional)
# ==========================================
# Share each listed Doc or Drive folder with the SAME service-account email used
# for Google Sheets. Enable Google Docs API and Google Drive API in that Google
# Cloud project. Values may be Google URLs or IDs, comma-separated. Folder
# sources include direct Google Docs in that folder (up to RAG_MAX_DOCS).
# You can also manage the same sources in OfficeOS → AI Settings.
#RAG_GOOGLE_DOC_IDS=
#RAG_GOOGLE_DRIVE_FOLDER_IDS=
#RAG_DOC_CACHE_TTL_MS=300000
#RAG_MAX_DOCS=80
#RAG_MAX_DOC_CHARS=80000
# Optional: default is data/rag-index.json. Set another absolute path for a
# separate worker, read-only host, or isolated evaluation index.
#RAG_INDEX_PATH=
# Optional in-process scheduler (milliseconds). Example: 21600000 = 6 hours.
#RAG_SYNC_INTERVAL_MS=21600000

# ==========================================
# 5. Razib Operations Handbook RAG Worker (optional, read-only)
# ==========================================
# Deploy the separate razib-operations-rag Cloudflare Worker, crawl its
# handbook source, then set its public Worker BASE URL here (not the docs URL).
# OfficeOS only calls POST /chat and GET /health; it never calls /ingest/admin
# endpoints and it never sends tracker Sheet contents to this worker.
# This is distinct from CLOUDFLARE_WORKER_URL above, which is an LLM fallback.
#HANDBOOK_RAG_WORKER_URL=https://razib-operations-rag.<account>.workers.dev
# Optional only if the Worker protects /chat with a read-only bearer token.
# Do NOT paste the Worker INGEST_KEY here.
#HANDBOOK_RAG_WORKER_TOKEN=

# Optional ClickUp integration:
# - Set CLICKUP_API_TOKEN to enable reading task status and comments.
# - Set CLICKUP_AUTO_CLOSE_ENABLED=true only when you want sending an email to
#   automatically update the ClickUp time-track task status to "Closed" and post
#   a completion comment @mentioning the Account Manager and FYI @Md Atiar Rahman Ovi.
#   Leave false (default) to keep ClickUp sync strictly in DRY-RUN mode.
#CLICKUP_API_TOKEN=
CLICKUP_AUTO_CLOSE_ENABLED=false



