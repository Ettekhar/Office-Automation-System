# Auth data â€” contains session tokens and password hashes. NEVER commit.
data/auth-sessions.json
data/users.json

node_modules/
.env
service-account.json
dry-run-previews/

# Holds API tokens entered from the dashboard (AI Settings) â€” never commit
data/assistant-config.json
data/sheet-credentials.json
data/mailer-credentials.json
data/active-tunnel.json
data/cloudflared.exe
*.exe
data/custom-sheets.json
# Generated RAG data contains synchronized internal Sheets/Docs content.
# Rebuild locally or during deployment with `npm run sync:rag`; never commit it.
data/rag-index.json
# Runtime-only aggregate provider health counters.
data/assistant-metrics.json
# Cached mirror of the Report Automation daily report log (chat RAG bridge).
data/daily-reports.json

# Runtime audit trail. Records WHO changed WHAT in the live system, including the
# exact cell and value written, and a read of it lists real client hostnames. It is
# a machine-local record, not source, and the GitHub remote is PUBLIC.
data/audit-log.json
# Sync conflict quarantine. Holds row snapshots of real client sheets.
data/sync-conflicts.json
# Conditional-note registry. Each record's `condition` is a literal keyword that is
# matched against report-tab text, and the note body is inserted VERBATIM into a
# client-facing email. The current live registry contains a racial slur, which is
# exactly the sort of string that must not be made permanent in a PUBLIC git
# remote. Ignored for that reason and not merely for tidiness.
data/email-conditional-notes.json
.tmp*
*.original

# wrangler build output. Regenerated by `npx wrangler deploy`; never useful in git.
# NB: cloudflare-worker/wrangler.toml (the pre-existing dev-assistant worker) is
# NOT ignored - only the local build caches are.
.wrangler/
**/.wrangler/
.wrangler-dryrun/
**/.wrangler-dryrun/
.dev.vars
**/.dev.vars

# Local dev-server logs. Machine-local, and they embed mojibake from the Windows
# console codepage, so they are noise in a public diff.
server-stdout.log
server-stderr.log

# Point-in-time dumps of live data, written by the scratch/ investigation scripts.
# These are throwaway working copies, not fixtures: sites_restored_preview.json in
# particular is a 525 KB copy of the real sites table with 105 client domains and
# staff email addresses in it. The test fixtures that ARE worth keeping
# (scratch/fixture-sheets-*.mjs) use invented .test hosts and are not matched here.
scratch/*-snapshot.json
scratch/*_preview.json
scratch/row-highlight-before.json
# One-off probes against the LIVE sheets. Each hardcodes a hostname or row number
# from a single investigation, so they are transcripts, not reusable tests - and
# running them again hits the live spreadsheets. Kept locally for the record.
scratch/inspect-*.mjs
scripts/discovery-report-raw.md

scratch/route-classification.json

scratch/live-sweep.json

scratch/kv-seed-dryrun.json

cloudflare-worker/.dev.vars

# First-run setup wizard flag — machine-local, never commit
data/.setup-complete
